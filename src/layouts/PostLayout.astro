---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';

type Props = {
  post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, category, tags, image, canonicalUrl } = post.data;
const canonical = canonicalUrl ?? new URL(`/posts/${post.id}/`, Astro.site).toString();
const formatDate = (date: Date) => date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@type': 'Person', name: AUTHOR_NAME },
  publisher: { '@type': 'Person', name: AUTHOR_NAME },
  mainEntityOfPage: canonical,
  url: canonical,
  image: image ? new URL(image, Astro.site).toString() : new URL('/og-default.png', Astro.site).toString(),
  keywords: tags.join(', '),
  inLanguage: 'ko-KR',
};
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} image={image} type="article">
  <article class="post page-shell">
    <header class="post-header">
      <a class="eyebrow" href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <span>{AUTHOR_NAME}</span>
        <span aria-hidden="true">·</span>
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        {updatedAt && <span>수정 {formatDate(updatedAt)}</span>}
      </div>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label="태그">
          {tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
        </ul>
      )}
    </header>
    <div class="post-content">
      <slot />
    </div>
    <footer class="post-footer">
      <p>이 글은 {SITE_TITLE}에 기록한 한동건의 개발 노트입니다.</p>
      <a href="/posts/">모든 글 보기 →</a>
    </footer>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</BaseLayout>
