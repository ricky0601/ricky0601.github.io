---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." noindex>
  <section class="not-found page-shell">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경되었거나 삭제된 페이지일 수 있습니다.</p>
    <a class="button primary" href="/">홈으로 돌아가기</a>
  </section>
</BaseLayout>
